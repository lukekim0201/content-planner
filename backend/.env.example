# --- Database ------------------------------------------------------------
# Local dev default is a SQLite file, so `uvicorn app.main:app --reload`
# works with zero setup. Point this at Postgres for anything real
# (Render/Railway give you a DATABASE_URL — paste it here, or set it
# directly as an env var on the platform).
DATABASE_URL=sqlite:///./content_planner.db
# DATABASE_URL=postgresql://user:password@localhost:5432/content_planner

# --- Auth ------------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# --- CORS --------------------------------------------------------------
# Comma-separated extra origins allowed to call this API (your deployed
# Vercel frontend URL, for example). localhost:5173 is always allowed.
ALLOWED_ORIGINS=https://your-app.vercel.app

# --- Public URL of this API --------------------------------------------
# Used to build download links for locally-stored assets when S3
# Storage isn't configured. Set this to your Render/Railway URL in prod.
PUBLIC_BASE_URL=http://localhost:8000

# --- Asset storage (optional) --------------------------------------------
# Leave these unset to store uploads on local disk (served back from this
# API at /uploads/...) — fully functional for local dev with no cloud
# account. Set all of AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
# AWS_S3_BUCKET to switch to S3 automatically. The bucket needs public-read
# access on its objects (or adapt app/storage.py to return presigned GET
# URLs instead if you'd rather keep it private).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# --- AI scene brainstorming (optional stretch goal) -----------------------
# Leave unset and the "Suggest next scene" button just explains it's off.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
